    def test_reset_password_endpoint_exists(self):
        """Test que l'endpoint de reset de mot de passe existe"""
        response = client.post("/api/v1/auth/reset-password", json={})
        assert response.status_code != 404

    def test_users_list_unauthorized(self):
        """Test de la liste des utilisateurs sans authentification"""
        response = client.get("/api/v1/auth/users")
        assert response.status_code in [401, 403]

    def test_community_stats_unauthorized(self):
        """Test des statistiques communautaires sans authentification"""
        response = client.get("/api/v1/auth/community/stats")
        assert response.status_code in [401, 403]

    def test_community_stats_with_parameters(self):
        """Test des statistiques avec paramètres"""
        params = {
            "page": 1,
            "per_page": 10,
            "sort_by": "contributions",
            "sort_order": "desc"
        }
        response = client.get("/api/v1/auth/community/stats", params=params)
        assert response.status_code in [401, 403]  # Toujours non autorisé

    def test_update_user_role_unauthorized(self):
        """Test de mise à jour de rôle sans authentification"""
        role_data = {
            "role": "MODERATEUR"
        }
        response = client.put("/api/v1/auth/users/1/role", json=role_data)
        assert response.status_code in [401, 403]

    def test_validate_token_endpoint_exists(self):
        """Test que l'endpoint de validation de token existe"""
        response = client.post("/api/v1/auth/validate-token", json={})
        assert response.status_code != 404

    def test_validate_token_invalid(self):
        """Test de validation avec token invalide"""
        token_data = {
            "token": "invalid.token.here"
        }
        response = client.post("/api/v1/auth/validate-token", json=token_data)
        assert response.status_code in [400, 401, 422]

    def test_deactivate_user_unauthorized(self):
        """Test de désactivation d'utilisateur sans authentification"""
        response = client.post("/api/v1/auth/users/1/deactivate")
        assert response.status_code in [401, 403]

    def test_activate_user_unauthorized(self):
        """Test d'activation d'utilisateur sans authentification"""
        response = client.post("/api/v1/auth/users/1/activate")
        assert response.status_code in [401, 403]


class TestAuthValidation:
    """Tests pour la validation des données d'authentification"""

    def test_email_format_validation(self):
        """Test de validation du format email"""
        invalid_emails = [
            "notanemail",
            "invalid@",
            "@invalid.com",
            "spaces in@email.com",
            "double@@email.com"
        ]
        
        for email in invalid_emails:
            data = {
                "email": email,
                "username": "testuser",
                "password": "validpassword123",
                "password_confirm": "validpassword123"
            }
            response = client.post("/api/v1/auth/register", json=data)
            assert response.status_code in [400, 422], f"Email {email} should be invalid"

    def test_password_strength_validation(self):
        """Test de validation de la force du mot de passe"""
        weak_passwords = [
            "123",           # Trop court
            "password",      # Trop simple
            "12345678",      # Que des chiffres
            "abcdefgh"       # Que des lettres
        ]
        
        for password in weak_passwords:
            data = {
                "email": "test@example.com",
                "username": "testuser",
                "password": password,
                "password_confirm": password
            }
            response = client.post("/api/v1/auth/register", json=data)
            assert response.status_code in [400, 422], f"Password {password} should be invalid"

    def test_password_confirmation_mismatch(self):
        """Test de non-correspondance des mots de passe"""
        data = {
            "email": "test@example.com",
            "username": "testuser",
            "password": "validpassword123",
            "password_confirm": "differentpassword123"
        }
        response = client.post("/api/v1/auth/register", json=data)
        assert response.status_code in [400, 422]

    def test_username_validation(self):
        """Test de validation du nom d'utilisateur"""
        invalid_usernames = [
            "",              # Vide
            "a",             # Trop court
            "user name",     # Espaces
            "user@name",     # Caractères spéciaux
            "a" * 100        # Trop long
        ]
        
        for username in invalid_usernames:
            data = {
                "email": "test@example.com",
                "username": username,
                "password": "validpassword123",
                "password_confirm": "validpassword123"
            }
            response = client.post("/api/v1/auth/register", json=data)
            assert response.status_code in [400, 422], f"Username {username} should be invalid"

    def test_required_fields_validation(self):
        """Test de validation des champs requis"""
        required_fields = ["email", "username", "password", "password_confirm"]
        
        for field in required_fields:
            data = {
                "email": "test@example.com",
                "username": "testuser",
                "password": "validpassword123",
                "password_confirm": "validpassword123"
            }
            # Supprimer le champ requis
            del data[field]
            
            response = client.post("/api/v1/auth/register", json=data)
            assert response.status_code in [400, 422], f"Field {field} should be required"


class TestAuthResponses:
    """Tests pour les formats de réponse de l'API d'authentification"""

    def test_error_response_format(self):
        """Test du format des réponses d'erreur"""
        response = client.post("/api/v1/auth/login", json={
            "email": "invalid",
            "password": "invalid"
        })
        
        if response.status_code in [400, 422]:
            data = response.json()
            # Doit avoir soit 'detail' soit 'message'
            assert "detail" in data or "message" in data or "errors" in data

    def test_success_response_structure(self):
        """Test de la structure des réponses de succès"""
        # Ce test ne peut pas vraiment réussir sans une vraie DB,
        # mais on peut vérifier que la structure est cohérente
        response = client.post("/api/v1/auth/register", json={
            "email": "newuser@example.com",
            "username": "newuser",
            "password": "strongpassword123",
            "password_confirm": "strongpassword123",
            "first_name": "New",
            "last_name": "User"
        })
        
        # Même si ça échoue, la réponse doit être JSON valide
        assert response.headers.get("content-type", "").startswith("application/json")

    def test_cors_headers_present(self):
        """Test de la présence des headers CORS"""
        response = client.options("/api/v1/auth/login")
        
        # Les headers CORS devraient être présents
        headers = response.headers
        assert "access-control-allow-origin" in [h.lower() for h in headers.keys()] or \
               "Access-Control-Allow-Origin" in headers

    def test_content_type_json(self):
        """Test que les réponses sont en JSON"""
        endpoints = [
            "/api/v1/auth/register",
            "/api/v1/auth/login",
            "/api/v1/auth/refresh"
        ]
        
        for endpoint in endpoints:
            response = client.post(endpoint, json={})
            content_type = response.headers.get("content-type", "")
            assert content_type.startswith("application/json")

    def test_rate_limiting_headers(self):
        """Test de la présence des headers de rate limiting"""
        response = client.post("/api/v1/auth/login", json={})
        
        # Les headers de rate limiting peuvent être présents
        headers = response.headers
        rate_limit_headers = [h for h in headers.keys() if "rate" in h.lower() or "limit" in h.lower()]
        # Ce test vérifie juste que si des headers sont présents, ils sont bien formés
        for header in rate_limit_headers:
            assert headers[header] is not None 